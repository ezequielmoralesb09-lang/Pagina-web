<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GTA VI | Trailers</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #0b0b0b;
            color: white;
        }

        /* NAVBAR */
        header {
            background: #111;
            padding: 20px 50px;
            border-bottom: 2px solid #ff8c00;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        header h1 {
            font-size: 26px;
            color: #ff8c00;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin-left: 25px;
            font-weight: bold;
            transition: 0.3s;
        }

        nav a:hover {
            color: #ff8c00;
        }

        /* HERO */
        .hero {
            text-align: center;
            padding: 70px 20px 50px;
            background:
                linear-gradient(rgba(0,0,0,0.65), rgba(0,0,0,0.9)),
                url("https://i.ytimg.com/vi/VQRLujxTm3c/maxresdefault.jpg");
            background-size: cover;
            background-position: center;
        }

        .hero h2 {
            font-size: 50px;
            margin-bottom: 15px;
        }

        .hero p {
            color: #ccc;
            font-size: 18px;
        }

        /* TRAILERS */
        .trailers-container {
            max-width: 1100px;
            margin: 60px auto;
            padding: 0 25px;
        }

        .trailer {
            background: #151515;
            margin-bottom: 50px;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            transition: 0.3s;
        }

        .trailer:hover {
            transform: translateY(-6px);
        }

        .trailer img {
            width: 100%;
            display: block;
        }

        .trailer-info {
            padding: 30px;
        }

        .trailer-info h3 {
            font-size: 30px;
            margin-bottom: 10px;
        }

        .date {
            color: #ff8c00;
            font-weight: bold;
            margin-bottom: 18px;
        }

        .trailer-info p {
            color: #ccc;
            line-height: 1.6;
            margin-bottom: 25px;
        }

        .youtube-button {
            display: inline-block;
            background: #ff0000;
            color: white;
            padding: 13px 25px;
            border-radius: 7px;
            text-decoration: none;
            font-weight: bold;
            transition: 0.3s;
        }

        .youtube-button:hover {
            background: #cc0000;
            transform: scale(1.05);
        }

        /* FOOTER */
        footer {
            text-align: center;
            padding: 30px;
            background: #111;
            color: #777;
            border-top: 1px solid #222;
        }

        /* RESPONSIVE */
        @media (max-width: 700px) {
            header {
                flex-direction: column;
                gap: 20px;
                padding: 20px;
            }

            nav {
                text-align: center;
            }

            nav a {
                margin: 5px 8px;
                display: inline-block;
            }

            .hero h2 {
                font-size: 35px;
            }

            .trailer-info h3 {
                font-size: 24px;
            }
        }
    </style>
</head>
<body>

    <!-- NAVEGACIÓN -->
    <header>
        <h1>GTA VI</h1>
        <nav>
            <a href="index.html">Inicio</a>
            <a href="leaks.html">Filtraciones</a>
            <a href="characters.html">Personajes</a>
            <a href="map.html">Mapa</a>
            <a href="trailers.html">Trailers</a>
        </nav>
    </header>

    <!-- ENCABEZADO -->
    <section class="hero">
        <h2>TRAILERS</h2>
        <p>Todos los trailers oficiales de Grand Theft Auto VI</p>
    </section>

    <!-- TRAILERS -->
    <main class="trailers-container">

        <!-- TRAILER 2 -->
        <article class="trailer">
            <img src="https://i.ytimg.com/vi/VQRLujxTm3c/maxresdefault.jpg" alt="Grand Theft Auto VI Trailer 2">
            <div class="trailer-info">
                <h3>Grand Theft Auto VI — Trailer 2</h3>
                <div class="date">📅 6 de mayo de 2025</div>
                <p>
                    El segundo trailer oficial presenta una mirada más profunda a Jason y Lucia y al estado de Leonida.
                    Rockstar confirmó que las imágenes fueron capturadas íntegramente dentro del juego en PlayStation 5.
                </p>
                <a class="youtube-button" href="https://www.youtube.com/watch?v=VQRLujxTm3c" target="_blank" rel="noopener noreferrer">
                    ▶ Ver en YouTube
                </a>
            </div>
        </article>

        <!-- TRAILER 1 -->
        <article class="trailer">
            <img src="https://i.ytimg.com/vi/QdBZY2fkU-0/maxresdefault.jpg" alt="Grand Theft Auto VI Trailer 1">
            <div class="trailer-info">
                <h3>Grand Theft Auto VI — Trailer 1</h3>
                <div class="date">📅 4 de diciembre de 2023</div>
                <p>
                    El primer trailer oficial de GTA VI presentó por primera vez Vice City y el estado de Leonida,
                    además de introducir a Lucia como una de las protagonistas del juego.
                </p>
                <a class="youtube-button" href="https://www.youtube.com/watch?v=QdBZY2fkU-0" target="_blank" rel="noopener noreferrer">
                    ▶ Ver en YouTube
                </a>
            </div>
        </article>

    </main>

    <!-- FOOTER -->
    <footer>
        <p>GTA VI Fan Site — Proyecto no oficial</p>
    </footer>

</body>
</html>
